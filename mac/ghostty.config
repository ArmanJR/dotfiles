# Font and appearance
font-family = "JetBrainsMono Nerd Font"
font-size = 16
theme = Synthwave
window-theme = dark

# Cursor
cursor-color = cell-foreground
cursor-text = cell-background
cursor-opacity = 0.8
cursor-style = block
cursor-style-blink = false

# Shell and SSH
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Windows
maximize = false
quit-after-last-window-closed = false
window-save-state = always
window-width = 120
window-height = 40
window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Long-running command notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# Existing application-specific bindings
keybind = shift+enter=text:\x1b\r
keybind = ctrl+grave_accent=text:\x1b[96;5u

# Window switching and split layout
keybind = cmd+alt+page_down=goto_window:next
keybind = cmd+alt+page_up=goto_window:previous
keybind = cmd+alt+equal=equalize_splits

# Open scrollback in the default text-file application
keybind = cmd+shift+e=write_scrollback_file:open

# macOS
macos-icon = xray
